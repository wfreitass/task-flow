{#- Versão em texto puro do e-mail de tarefa atribuída (mesmas variáveis do .html.twig). Sem escape de HTML. -#}
{%- import 'email/_labels.txt.twig' as labels -%}
Olá, {{ assignee }}!

{{ assigner }} atribuiu a tarefa "{{ task.title }}" a você.

Prioridade: {{ labels.priority(task.priority) }}
Status: {{ labels.status(task.status) }}
