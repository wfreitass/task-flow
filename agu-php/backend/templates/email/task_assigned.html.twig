{#
    E-mail "Você foi designado(a) para uma tarefa". Variáveis: assignee, assigner (nomes) e task (id, title,
    description, priority, status, dueDate). Todo valor passa pelo escape do Twig; nada vindo do usuário é "raw".
#}
{% extends 'email/layout.html.twig' %}
{%- import 'email/_labels.txt.twig' as labels -%}

{# Cor do selo de cada prioridade: [fundo, texto]. #}
{% set badge = {
    'low': ['#dcfce7', '#166534'],
    'medium': ['#fef3c7', '#92400e'],
    'high': ['#ffedd5', '#9a3412'],
    'urgent': ['#fee2e2', '#991b1b'],
}[task.priority] ?? ['#e2e8f0', '#334155'] %}

{% block subject %}Você foi designado(a) para a tarefa: {{ task.title }}{% endblock %}

{% block preheader %}{{ assigner }} atribuiu a tarefa "{{ task.title }}" a você.{% endblock %}

{% block content %}
    <h1 class="title" style="margin:0 0 16px 0; font-size:22px; line-height:1.3; color:#0f172a;">Nova tarefa para você</h1>

    <p class="text" style="margin:0 0 8px 0;">Olá, <strong class="strong">{{ assignee }}</strong>!</p>
    <p class="text" style="margin:0 0 24px 0;"><strong class="strong">{{ assigner }}</strong> atribuiu uma tarefa a você:</p>

    {# Cartão da tarefa #}
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" class="panel" style="background-color:#f8fafc; border:1px solid #e2e8f0; border-radius:8px;">
        <tr>
            <td style="padding:20px;">
                <div class="title" style="font-size:18px; font-weight:bold; line-height:1.4; color:#0f172a; margin:0 0 12px 0;">{{ task.title }}</div>

                <span style="display:inline-block; padding:3px 10px; border-radius:999px; font-size:12px; font-weight:bold; background-color:{{ badge[0] }}; color:{{ badge[1] }};">
                    Prioridade {{ labels.priority(task.priority)|lower }}
                </span>
                <span style="display:inline-block; padding:3px 10px; border-radius:999px; font-size:12px; font-weight:bold; background-color:#e0e7ff; color:#3730a3;">
                    {{ labels.status(task.status) }}
                </span>

                {% if task.dueDate is not null %}
                    <p class="text" style="margin:16px 0 0 0; font-size:14px;">
                        <span class="muted" style="color:#64748b;">Vencimento:</span>
                        <strong class="strong">{{ task.dueDate|date('d/m/Y H:i', 'UTC') }} (UTC)</strong>
                    </p>
                {% endif %}

                {% if task.description is not null %}
                    <p class="muted" style="margin:16px 0 4px 0; font-size:12px; font-weight:bold; text-transform:uppercase; letter-spacing:0.04em; color:#64748b;">Descrição</p>
                    <p class="text" style="margin:0; font-size:14px;">{{ task.description|nl2br }}</p>
                {% endif %}
            </td>
        </tr>
    </table>

    {# Botão #}
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:28px 0 0 0;">
        <tr>
            <td style="background-color:#4f46e5; border-radius:8px;">
                <a href="{{ app_url|trim('/', 'right') }}/tasks" style="display:inline-block; padding:12px 24px; font-size:15px; font-weight:bold; color:#ffffff; text-decoration:none;">Abrir o TaskFlow</a>
            </td>
        </tr>
    </table>
{% endblock %}
